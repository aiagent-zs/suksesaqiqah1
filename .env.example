# ============================================================
# Sukses Aqiqah — contoh environment
# Salin ke .env.local lalu isi kredensial asli. JANGAN commit .env.local
# ============================================================

# --- Supabase (Tahap 1-3) ---
# Nilai lokal keluar dari `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Layer (Tahap 9) ---
ANTHROPIC_API_KEY=

# --- Payment gateway (Tahap 10) ---
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_CLIENT_KEY=

# --- Google Maps (scheduling/lokasi, Tahap 4) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Automation / n8n (Tahap 8) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
