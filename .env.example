# ============================================================
# Sukses Aqiqah — contoh environment
# Salin ke .env.local lalu isi kredensial asli. JANGAN commit .env.local
# ============================================================

# --- Supabase (Tahap 1-3) ---
# Cloud : Settings > API Keys di dashboard Supabase
# Lokal : nilainya keluar dari `npm run db:start`
NEXT_PUBLIC_SUPABASE_URL=
# Kunci publik (tunduk RLS). Nama lama `NEXT_PUBLIC_SUPABASE_ANON_KEY` masih diterima.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Kunci rahasia — JANGAN pernah dipakai di kode yang terkirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string Postgres, dipakai Supabase CLI untuk `db push` / `db diff`.
SUPABASE_DB_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Kontak publik (landing page & footer — 27_PAGE_MENU) ---
# Nomor WhatsApp format internasional tanpa "+", mis. 6281234567890
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/zakatsukses
NEXT_PUBLIC_CONTACT_EMAIL=halo@zakatsukses.org

# --- AI Layer (Tahap 9) ---
ANTHROPIC_API_KEY=

# --- Payment gateway (Tahap 10) ---
PAYMENT_GATEWAY_SERVER_KEY=
PAYMENT_GATEWAY_CLIENT_KEY=

# --- Google Maps (scheduling/lokasi, Tahap 4) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Automation / n8n (Tahap 8) ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
